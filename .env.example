# Senha única de acesso ao sistema (compartilhada entre os usuários)
APP_PASSWORD=troque-esta-senha

# Segredo para assinar os cookies de sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=

# Chave da OpenAI para a busca com IA
OPENAI_API_KEY=

# Limite de buscas com IA por hora, por sessão (padrão: 100)
AI_SEARCH_LIMIT_PER_HOUR=100

# Porta do servidor (padrão: 5000)
PORT=5000

# Banco de dados (ainda não utilizado; os dados ficam em memória)
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
